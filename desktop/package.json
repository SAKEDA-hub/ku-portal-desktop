{
  "name": "ku-portal-desktop",
  "productName": "KU Portal",
  "version": "1.0.0",
  "description": "KU Portal — настольное приложение Kozybayev University (портал, AI-помощник, онлайн-экзамен)",
  "author": {
    "name": "SAKEDA-hub",
    "email": "noreply@github.com"
  },
  "license": "UNLICENSED",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --publish never",
    "dist:win": "electron-builder --win --publish never",
    "dist:mac": "electron-builder --mac --publish never",
    "dist:linux": "electron-builder --linux --publish never"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "kz.ku.portal.desktop",
    "productName": "KU Portal",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "config.js",
      "preload.js",
      "settings-preload.js",
      "ui/**/*"
    ],
    "extraResources": [
      {
        "from": "../app",
        "to": "app",
        "filter": [
          "**/*",
          "!data/db.json",
          "!data/exam-sync.json",
          "!data/ku_context.json",
          "!node_modules/**"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "KU Portal",
      "artifactName": "KU-Portal-Setup.${ext}"
    },
    "portable": {
      "artifactName": "KU-Portal-Portable.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.education",
      "icon": "build/icon.png",
      "artifactName": "KU-Portal-mac-${arch}.${ext}"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Education",
      "icon": "build/icon.png",
      "maintainer": "SAKEDA-hub",
      "artifactName": "KU-Portal-linux.${ext}"
    }
  },
  "homepage": "https://github.com/SAKEDA-hub/ku-portal-desktop"
}
